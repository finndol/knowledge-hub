---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Rough reading time from the raw markdown body (~200 wpm).
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "author": { "@type": "Person", "name": "Finn Dollimore" },
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />

  <div data-theme="dark" class="min-h-screen bg-surface-page text-primary">
    <div class="u-container py-section-xl">
      <article class="max-w-prose u-stack-xl">

        {/* BACK LINK */}
        <a
          href="/blog"
          class="group inline-flex w-fit items-center gap-2xs text-small uppercase text-secondary transition-colors hover:text-primary"
          style="letter-spacing: 0.1em;"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform duration-200 group-hover:-translate-x-1"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
          </svg>
          <span>All writing</span>
        </a>

        {/* HEADER */}
        <header class="u-stack-md">
          <div
            class="flex flex-wrap items-center gap-sm text-small uppercase text-muted"
            style="letter-spacing: 0.1em;"
          >
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            <span class="h-px w-md bg-border-strong" aria-hidden="true"></span>
            <span>{readingTime} min read</span>
          </div>

          <h1>{post.data.title}</h1>

          <p class="text-xlarge text-secondary">{post.data.description}</p>

          {post.data.tags.length > 0 && (
            <ul class="flex list-none flex-wrap gap-2xs p-0 pt-2xs">
              {post.data.tags.map((tag) => (
                <li class="rounded-full border border-border-subtle px-xs py-3xs text-small text-secondary">
                  {tag}
                </li>
              ))}
            </ul>
          )}
        </header>

        {/* BODY */}
        <div class="post-body border-t border-border-subtle pt-lg">
          <Content />
        </div>

        {/* FOOTER */}
        <footer class="border-t border-border-subtle pt-lg">
          <a
            href="/blog"
            class="group inline-flex w-fit items-center gap-2xs text-medium font-medium transition-colors hover:text-brand-text"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform duration-200 group-hover:-translate-x-1"
              aria-hidden="true"
            >
              <line x1="19" y1="12" x2="5" y2="12" />
              <polyline points="12 19 5 12 12 5" />
            </svg>
            <span>Back to all writing</span>
          </a>
        </footer>

      </article>
    </div>
  </div>
</BaseLayout>

<style>
  /* Prose styles for rendered markdown. The body content is injected via
     <Content />, so its elements never receive Astro's scoped attribute —
     reach them through :global() under the .post-body wrapper. Spacing leans
     on the design-system tokens; leading-trim (see global.css) already pulls
     headings/paragraphs flush, so margin-top is the true visual gap. */

  .post-body > :global(:first-child) {
    margin-top: 0;
  }

  .post-body :global(p) {
    margin-top: var(--space-sm);
    font-size: var(--text-large);
    line-height: var(--leading-body);
    color: var(--text-secondary);
  }

  .post-body :global(h2) {
    margin-top: var(--space-xl);
    font-size: var(--text-h4);
    line-height: var(--leading-tight);
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--text-primary);
  }

  .post-body :global(h3) {
    margin-top: var(--space-lg);
    font-size: var(--text-h5);
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-body :global(h4) {
    margin-top: var(--space-md);
    font-size: var(--text-h6);
    line-height: var(--leading-tight);
    font-weight: 600;
    color: var(--text-primary);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-top: var(--space-sm);
    padding-left: var(--space-md);
    font-size: var(--text-large);
    color: var(--text-secondary);
  }

  .post-body :global(ul) { list-style: disc; }
  .post-body :global(ol) { list-style: decimal; }

  .post-body :global(li) { margin-top: var(--space-2xs); }
  .post-body :global(li)::marker { color: var(--text-muted); }

  .post-body :global(a) {
    color: var(--text-brand);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--border-strong);
    transition: text-decoration-color 0.15s ease;
  }
  .post-body :global(a:hover) {
    text-decoration-color: var(--text-brand);
  }

  .post-body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .post-body :global(em) { font-style: italic; }

  .post-body :global(blockquote) {
    margin-top: var(--space-md);
    padding-left: var(--space-md);
    border-left: 2px solid var(--brand-default);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: var(--text-h5);
    color: var(--text-secondary);
  }

  .post-body :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875em;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: 0.25rem;
    padding: 0.15em 0.4em;
  }

  .post-body :global(pre) {
    margin-top: var(--space-md);
    padding: var(--space-md);
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: var(--text-small);
    line-height: 1.6;
  }
  .post-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  .post-body :global(img) {
    margin-top: var(--space-md);
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .post-body :global(hr) {
    margin-top: var(--space-xl);
    border: none;
    border-top: 1px solid var(--border-subtle);
  }
</style>
